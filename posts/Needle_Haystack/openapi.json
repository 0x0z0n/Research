            "parameters":[
               {
                  "name":"app_id",
                  "in":"path",
                  "required":true,
                  "schema":{
                     "type":"string",
                     "title":"App Id"
                  }
               },
               {
                  "name":"email",
                  "in":"query",
                  "required":true,
                  "schema":{
                     "type":"string",
                     "title":"Email"
                  }
               }
            ],
            "responses":{
               "200":{
                  "description":"Successful Response",
                  "content":{
                     "application/json":{
                        "schema":{
                           
                        }
                     }
                  }
               },
               "422":{
                  "description":"Validation Error",
                  "content":{
                     "application/json":{
                        "schema":{
                           "$ref":"#/components/schemas/HTTPValidationError"
                        }
                     }
                  }
               }
            }
         }
      },
