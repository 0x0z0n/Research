ld_timeout.o: ld_timeout-ld_timeout.o
	$(LIBTOOL) --mode=link $(CC) -o $@ $^

ld_timeout.so: ld_timeout.o
	$(CC) -shared -o ld_timeout.so ld_timeout.o -ldl

test: $(noinst_PROGRAMS)
	for TEST in $(T); do \
		echo "Running $$TEST"; \
		echo "--------------"; \
		sh $$TEST || exit 1;   \
		echo "--------------"; \
		echo; \
	done

